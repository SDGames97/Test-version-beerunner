        self.addEventListener('install', e => self.skipWaiting());
        self.addEventListener('activate', e => self.clients.claim());
        self.addEventListener('fetch', e => e.respondWith(fetch(e.request).catch(() => caches.match(e.request))));
      `;
      navigator.serviceWorker.register(URL.createObjectURL(new Blob([swCode], { type: 'text/javascript' })));
    }

    // -------------------------------------------------------------------
    // 3D Spiel-Logik (Three.js)
    // -------------------------------------------------------------------
    let scene, camera, renderer, beeGroup;
    let currentLane = 1; // 0: Links, 1: Mitte, 2: Rechts
    const laneX = [-2, 0, 2];
    let score = 0;
    let distance = 0;
    let isGameOver = false;

    let obstacles = [];
    let coins = [];

    function init() {
      const container = document.getElementById('game-container');

      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x1a1a2e);
      scene.fog = new THREE.Fog(0x1a1a2e, 10, 50);

      camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
      camera.position.set(0, 3, 6);
      camera.lookAt(0, 1, 0);

      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      container.appendChild(renderer.domElement);

      // Licht
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
      scene.add(ambientLight);
      const dirLight = new THREE.DirectionalLight(0xffffff, 1.2);
      dirLight.position.set(5, 10, 5);
      scene.add(dirLight);

      // 3D-Biene erzeugen (Prozedural aufgebaut für blitzschnelles Laden)
      beeGroup = new THREE.Group();
      
      // Körper (Schwarz-Gelb)
      const bodyGeo = new THREE.SphereGeometry(0.5, 16, 16);
      bodyGeo.scale(0.8, 0.8, 1.2);
      const bodyMat = new THREE.MeshStandardMaterial({ color: #f1c40f });
      const body = new THREE.Mesh(bodyGeo, bodyMat);
      beeGroup.add(body);

      // Flügel
      const wingGeo = new THREE.BoxGeometry(0.8, 0.05, 0.4);
      const wingMat = new THREE.MeshStandardMaterial({ color: 0xffffff, transparent: true, opacity: 0.7 });
      const leftWing = new THREE.Mesh(wingGeo, wingMat);
      leftWing.position.set(-0.5, 0.3, 0);
      const rightWing = new THREE.Mesh(wingGeo, wingMat);
      rightWing.position.set(0.5, 0.3, 0);
      beeGroup.add(leftWing);
      beeGroup.add(rightWing);

      beeGroup.position.set(0, 1, 0);
      scene.add(beeGroup);

      // Laufsteg / Boden
      const trackGeo = new THREE.PlaneGeometry(7, 100);
      const trackMat = new THREE.MeshStandardMaterial({ color: 0x2c3e50 });
      const track = new THREE.Mesh(trackGeo, trackMat);
      track.rotation.x = -Math.PI / 2;
      track.position.z = -40;
      scene.add(track);

      // Steuerung Event-Listener
      document.getElementById('touch-left').addEventListener('click', () => moveBee(-1));
      document.getElementById('touch-right').addEventListener('click', () => moveBee(1));
      
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') moveBee(-1);
        if (e.key === 'ArrowRight') moveBee(1);
      });

      spawnObjects();
      animate();
    }

    function moveBee(dir) {
      if (isGameOver) return;
      currentLane = Math.max(0, Math.min(2, currentLane + dir));
    }

    function spawnObjects() {
      for (let i = 0; i < 15; i++) {
        spawnObstacle(-10 - i * 8);
        spawnCoin(-14 - i * 8);
      }
    }

    function spawnObstacle(zPos) {
      const lane = Math.floor(Math.random() * 3);
      const geo = new THREE.BoxGeometry(0.8, 0.8, 0.8);
      const mat = new THREE.MeshStandardMaterial({ color: 0xe74c3c });
      const obstacle = new THREE.Mesh(geo, mat);
      obstacle.position.set(laneX[lane], 0.8, zPos);
      scene.add(obstacle);
      obstacles.push(obstacle);
    }

    function spawnCoin(zPos) {
      const lane = Math.floor(Math.random() * 3);
      const geo = new THREE.CylinderGeometry(0.3, 0.3, 0.1, 16);
      const mat = new THREE.MeshStandardMaterial({ color: 0xf1c40f, metalness: 0.8 });
      const coin = new THREE.Mesh(geo, mat);
      coin.rotation.x = Math.PI / 2;
      coin.position.set(laneX[lane], 1, zPos);
      scene.add(coin);
      coins.push(coin);
    }

    function animate() {
      if (isGameOver) return;
      requestAnimationFrame(animate);

      // Biene fließend auf die gewählte Spur bewegen
      beeGroup.position.x += (laneX[currentLane] - beeGroup.position.x) * 0.2;
      
      // Sanftes Wackeln/Fliegen der Biene
      beeGroup.position.y = 1 + Math.sin(Date.now() * 0.005) * 0.1;

      distance += 0.1;
      document.getElementById('dist-text').innerText = `Strecke: ${Math.floor(distance)}m`;

      const speed = 0.2;

      // Hindernisse bewegen & Kollision prüfen
      for (let i = obstacles.length - 1; i >= 0; i--) {
        const obs = obstacles[i];
        obs.position.z += speed;

        // Kollisionsabfrage
        if (Math.abs(obs.position.z - beeGroup.position.z) < 0.6 &&
            Math.abs(obs.position.x - beeGroup.position.x) < 0.6) {
          triggerGameOver();
        }

        if (obs.position.z > 5) {
          obs.position.z = -100;
          obs.position.x = laneX[Math.floor(Math.random() * 3)];
        }
      }

      // Münzen bewegen & einsammeln
      for (let i = coins.length - 1; i >= 0; i--) {
        const coin = coins[i];
        coin.position.z += speed;
        coin.rotation.z += 0.05;

        // Münze eingesammelt
        if (Math.abs(coin.position.z - beeGroup.position.z) < 0.6 &&
            Math.abs(coin.position.x - beeGroup.position.x) < 0.6) {
          score += 10;
          document.getElementById('score-text').innerText = `Münzen: ${score}`;
          coin.position.z = -100;
          coin.position.x = laneX[Math.floor(Math.random() * 3)];
        }

        if (coin.position.z > 5) {
          coin.position.z = -100;
          coin.position.x = laneX[Math.floor(Math.random() * 3)];
        }
      }

      renderer.render(scene, camera);
    }

    function triggerGameOver() {
      isGameOver = true;
      document.getElementById('final-score').innerText = `Münzen gesammelt: ${score}`;
      document.getElementById('game-over').style.display = 'flex';
    }

    function resetGame() {
      score = 0;
      distance = 0;
      currentLane = 1;
      isGameOver = false;
      document.getElementById('score-text').innerText = `Münzen: 0`;
      document.getElementById('game-over').style.display = 'none';

      // Objekte zurücksetzen
      obstacles.forEach((obs, idx) => { obs.position.z = -10 - idx * 8; });
      coins.forEach((coin, idx) => { coin.position.z = -14 - idx * 8; });

      animate();
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    init();
  </script>
