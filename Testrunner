<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mein 3D PWA Game</title>
  <style>
    body { margin: 0; overflow: hidden; background: #000; }
    canvas { display: block; }
  </style>
  <!-- Three.js Bibliothek für 3D-Grafik -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <!-- GLTFLoader zum Laden von 3D-Modellen (.glb/.gltf) -->
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
</head>
<body>

<script>
  // 1. 3D-Szene, Kamera & Renderer aufsetzen
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  document.body.appendChild(renderer.domElement);

  // 2. Licht hinzufügen (damit das 3D-Modell sichtbar ist)
  const light = new THREE.DirectionalLight(0xffffff, 1.5);
  light.position.set(5, 10, 7.5);
  scene.add(light);
  scene.add(new THREE.AmbientLight(0x404040, 2));

  camera.position.set(0, 2, 5);

  let playerModel = null;

  // 3. Das 3D-Modell (.glb/.gltf) von einer URL laden
  const loader = new THREE.GLTFLoader();
  
  // Ersetze diese URL durch den Pfad zu deinem eigenen 3D-Modell
  const modelUrl = 'https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Models/master/2.0/Duck/glTF-Binary/Duck.glb';

  loader.load(modelUrl, function (gltf) {
    playerModel = gltf.scene;
    playerModel.scale.set(0.8, 0.8, 0.8); // Größe anpassen
    scene.add(playerModel);
    console.log("3D-Modell erfolgreich geladen!");
  }, undefined, function (error) {
    console.error("Fehler beim Laden des Modells:", error);
  });

  // 4. Spiel-Schleife (Animation & Steuerung)
  function animate() {
    requestAnimationFrame(animate);

    // Wenn das 3D-Modell geladen ist, lass es langsam rotieren
    if (playerModel) {
      playerModel.rotation.y += 0.01;
    }

    renderer.render(scene, camera);
  }

  animate();

  // Fenstergröße automatisch anpassen
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>

</body>
</html>
